<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================ -->
    <!-- REFERENCIA AL POM PADRE                                      -->
    <!-- ============================================================ -->
    <parent>
        <groupId>com.uniremington</groupId>
        <artifactId>uniremington-systemacademic</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- ============================================================ -->
    <!-- COORDENADAS DEL MODULO                                       -->
    <!-- ============================================================ -->
    <artifactId>api-gateway</artifactId>
    <name>API Gateway</name>
    <description>
        Punto central de entrada de los microservicios de UniRemington.
        Enruta el tráfico externo usando Service Discovery vía Eureka.
    </description>

    <!-- ============================================================ -->
    <!-- DEPENDENCIAS                                                 -->
    <!-- ============================================================ -->
    <dependencies>
        <!-- Spring Cloud Gateway Server MVC: starter gestionado por Spring Cloud 2025.x / Boot 4 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>

        <!-- Cliente Eureka: registra el gateway en el discovery server -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- Spring Cloud LoadBalancer: requerido para los URIs 'lb://' -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Actuator: expone health/info y el endpoint de rutas del gateway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Soporte de pruebas (sin uso de @SpringBootTest en este modulo) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ============================================================ -->
    <!-- BUILD                                                        -->
    <!-- ============================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
